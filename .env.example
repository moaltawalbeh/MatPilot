# ============================================
# MatPilot — Environment Variables
# ============================================
# Copy this file to .env and fill in values.
# All variables have sensible development defaults.

# ── Environment ──────────────────────────────
# development | staging | production
MATPILOT_ENV=development

# ── API Server ───────────────────────────────
MATPILOT_API_HOST=0.0.0.0
MATPILOT_API_PORT=8000

# Comma-separated list of allowed CORS origins.
# Defaults to the value of APP_URL (https://matpilot.site in production).
# Local development should set this explicitly to your local frontend origin.
# Example: https://matpilot.site,https://staging.matpilot.site
MATPILOT_CORS_ORIGINS=

# ── Database ─────────────────────────────────
# PostgreSQL connection string (required for Render deployment)
# Format: postgresql://user:password@host:port/dbname?sslmode=require
DATABASE_URL=

# ── Storage ──────────────────────────────────
# local | s3 | azure | gcs
MATPILOT_STORAGE_BACKEND=local
MATPILOT_STORAGE_PATH=./storage

# S3 (when MATPILOT_STORAGE_BACKEND=s3)
MATPILOT_S3_BUCKET=
MATPILOT_S3_REGION=

# Azure Blob (when MATPILOT_STORAGE_BACKEND=azure)
MATPILOT_AZURE_CONTAINER=

# Google Cloud Storage (when MATPILOT_STORAGE_BACKEND=gcs)
MATPILOT_GCS_BUCKET=

# ── Uploads ──────────────────────────────────
MATPILOT_TEMP_DIR=
MATPILOT_MAX_FILE_SIZE=52428800

# ── Analysis ─────────────────────────────────
MATPILOT_MAX_JOBS=4
MATPILOT_JOB_TIMEOUT=300
MATPILOT_DEFAULT_WAVELENGTH=1.5406

# ── Reference Database ──────────────────────
MATPILOT_CIF_CACHE_DIR=data/cif_cache
MATPILOT_COD_API_URL=https://www.crystallography.net/cod
MATPILOT_CACHE_TTL=3600
MATPILOT_SEARCH_TIMEOUT=30

# ── Logging ──────────────────────────────────
# DEBUG | INFO | WARNING | ERROR | CRITICAL
MATPILOT_LOG_LEVEL=INFO
MATPILOT_LOG_STRUCTURED=true

# ── Email / Verification ────────────────────
# Resend API key (https://resend.com). When set, verification and password
# reset emails are delivered via Resend; otherwise they are logged to the
# console. You may also force a transport with MATPILOT_EMAIL_BACKEND
# (resend | smtp | console).
RESEND_API_KEY=

# "From" address used for outbound email (Resend requires a verified domain).
# Example: MatPilot <no-reply@matpilot.site>
EMAIL_FROM=MatPilot <no-reply@matpilot.site>
# Legacy name also honoured when EMAIL_FROM is not set.
# MATPILOT_EMAIL_FROM=MatPilot <no-reply@matpilot.site>

# Public frontend URL used to build verification/reset links.
APP_URL=https://matpilot.site
# Legacy name also honoured when APP_URL is not set.
# MATPILOT_APP_URL=https://matpilot.site

# Email verification / password reset tokens expire after this many hours.
MATPILOT_VERIFY_TOKEN_TTL_HOURS=24

# Verification code length (digits).
MATPILOT_VERIFY_CODE_LENGTH=6

# ── Auth Rate Limiting ──────────────────────
# Per-client-IP request budgets within a sliding window. Disable with
# MATPILOT_RATE_LIMIT_ENABLED=false.
MATPILOT_RATE_LIMIT_ENABLED=true
MATPILOT_RATE_LIMIT_WINDOW_SECONDS=900
MATPILOT_RATE_LIMIT_LOGIN=10
MATPILOT_RATE_LIMIT_REGISTER=10
MATPILOT_RATE_LIMIT_VERIFY=20
MATPILOT_RATE_LIMIT_RESEND=5
MATPILOT_RATE_LIMIT_FORGOT=5
